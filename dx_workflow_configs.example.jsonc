        "image_path": { "path": "", "use_for_dim": false }, // input image path (empty for T2V). "use_for_dim" takes the output size from this image - the editor's image slot 1. Only one slot in the whole take may set it, here or in extended_media
        "audio_path": { "path": "", "from_video": 0 }, // absolute path to input reference audio file
        "width": { "value": 768 },         // output width in pixels
