        "seed": { "value": 0, "randomize": false }, // seed value; randomize: re-rolls each run
        "cfg_high": { "value": 1.0 },      // guidance scale (distilled models use low values near 1)
        "cfg_low": { "value": 0.0 },       // NOT USED by LTX node
