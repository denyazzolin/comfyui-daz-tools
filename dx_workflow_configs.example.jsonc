        "negative_prompt": { "text": "" }, // negative prompt text
        "trail_prompt":{ "text": "" },
        "loras": {
          "lora_1": { "name": "", "strength": 1.0, "enabled": true }, // LoRA slot 1 (typically the distillation LoRA)
