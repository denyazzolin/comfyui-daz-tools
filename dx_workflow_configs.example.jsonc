        "cfg_high": { "value": 3.0 },      // guidance scale (single CFG — labeled "CFG" in the UI)
        "cfg_low": { "value": 0.0 },       // NOT USED by LTX2.5 node
        "total_frames": { "value": 121 },  // total number of output video frames (duration x fps + 1)
        "fps": { "value": 24.0 },          // output video frame rate
        "master_prompt": { "text": "", "position": "before" },   // base prompt; combined with positive when type is not "smart"
        "positive_prompt": { "text": "A cinematic shot of ...", "type": "smart" }, // type "smart" forwards only this text to the relay node
        "negative_prompt": { "text": "" }, // negative prompt text
        "trail_prompt":{ "text": "" },
        "loras": {
          "lora_1": { "name": "", "strength": 1.0, "enabled": true }, // LoRA slot 1 (exposed as "distillation_lora" on the node)
          "lora_2": { "name": "", "strength": 1.0, "enabled": true }, // LoRA slot 2
          "lora_3": { "name": "", "strength": 1.0, "enabled": true }, // LoRA slot 3
          "lora_4": { "name": "", "strength": 1.0, "enabled": true }, // LoRA slot 4
          "lora_5": { "name": "", "strength": 1.0, "enabled": true }, // LoRA slot 5
          "lora_6": { "name": "", "strength": 1.0, "enabled": true }, // LoRA slot 6
          "lora_7": { "name": "", "strength": 1.0, "enabled": true }, // LoRA slot 7
          "lora_8": { "name": "", "strength": 1.0, "enabled": true }  // LoRA slot 8
        },
        "filename": { "file": "" },        // output filename (without extension)
        "flags": {
          "flag_1": { "label": "flag 1", "value": false }, // custom boolean toggle 1; label is the display name
          "flag_2": { "label": "flag 2", "value": false }, // custom boolean toggle 2
          "flag_3": { "label": "flag 3", "value": false }  // custom boolean toggle 3
        },
        "custom": {
          "param_1": { "label": "param 1", "value": "" }, // custom string parameter 1; label is the display name
          "param_2": { "label": "param 2", "value": "" }  // custom string parameter 2
        }
      }
    ]
  },
  "My MiniMax H3 Config": {               // config name — shown in the node dropdown
    "class": "m_h3",                      // node class this config targets
    "created_at": "2026-06-02T00:00:00",   // entry creation timestamp
    "updated_at": "2026-06-02T00:00:00",   // entry last-modified timestamp
    "sets": [                              // array of versioned parameter sets
      {
        "version": "1",                    // set version number (auto-incremented on save)
        "label": "My First Version",       // optional user-friendly label for this set version
        "created_at": "2026-06-02T00:00:00", // set creation timestamp
        "updated_at": "2026-06-02T00:00:00", // set last-modified timestamp
        "type": "I2V",                     // generation mode (e.g. I2V, T2V, MULTI); also picks the master prompt default template
        "group": { "name": "" },           // optional UI grouping label
        "note": { "value": "" },           // free-text note for this set
        "checkpoint": { "name": "" },      // NOT USED by MiniMax H3 node
        "unet_high": { "name": "minimax_h3_fp8.safetensors", "gguf": false }, // unet (diffusion) model — single pass, no high/low split
        "unet_low": { "name": "", "gguf": false },        // NOT USED by MiniMax H3 node
        "vae": { "name": "minimax_h3_video_vae.safetensors" },       // video VAE, from models/vae
        "audio_vae": { "name": "minimax_h3_audio_vae.safetensors" }, // audio VAE, also from models/vae
        "clip": { "name": "minimax_h3_text_encoder.safetensors" },   // text encoder (MiniMax clip type)
        "clip_2": { "name": "" },          // NOT USED by MiniMax H3 node
        "latent_upscale": { "name": "" },  // NOT USED by MiniMax H3 node (LTX2.3/LTX2.5 only)
        "clip_type": "stable_diffusion",   // NOT USED by MiniMax H3 node
        "shift_high": { "value": 0.0 },       // NOT USED by MiniMax H3 node
        "shift_low": { "value": 0.0 },        // NOT USED by MiniMax H3 node
        "image_path": { "path": "C:/path/to/input_image.png", "use_for_dim": true }, // absolute path to input image (for I2V). "use_for_dim" takes the output size from this image - the editor's image slot 1. Only one slot in the whole take may set it, here or in extended_media
        "audio_path": { "path": "", "from_video": 0 }, // absolute path to input reference audio file
        "width": { "value": 1280 },        // output width in pixels
        "height": { "value": 720 },        // output height in pixels
        "dimensions":{
             "use_image":false,            // "false" uses the width, height and scale attributes. "true" use the image's width and height
             "scale":{                     // the "use_image" is false, the scale attributes are used to scale the image given the width and height input
              "mode":"none",               // "none" does not change the image. "factor" scales the image given the "value" attribute (1.0 keeps teh same, 0.5 halfs the image size, etc). "longest" scales the image so the longest dimension of the image fits an input integer value. "fit" scales teh image to fit the width/height box, cropping at the center
              "value":1.0                  // if mode is "factor, the value as a flot is considered. If "longest", integer part of value is considered. IF "fit, value is ignored
             }
        },
        "extended_media":{                 // extra media the take carries, beyond the single image_path/audio_path slots above
          // "order" is a slot number, not a sort key: the nodes load only orders 1-4 / 1-2 / 1. In the editor
          // these are image slots 2-5, video slots 1-2 and audio slot 2 - its first image and audio slot is the
          // image_path / audio_path above. Holes are allowed, a slot keeps its name when a
          // neighbour is cleared, and rows outside that range (or a second row at an order already taken) stay
          // in the file untouched - they are simply not loaded. "name" is the label the Media Splitter shows.
          // "use_for_dim" marks the image or video the output size is meant to come from - the still's own size,
          // or the size of the video's frames. It is the same flag image_path carries above, and at most
          // one slot in the take may set it: the reference image wins, then images by slot, then videos.
          // Stored only for now, nothing reads it yet.
          "images":[{"name":"first_frame", "order":1, "image_path":"C:/path/to/first_frame.png", "use_for_dim":false}],
          "videos":[{"name":"drive_clip", "order":1, "video_path":"C:/path/to/clip.mp4", "duration":0, "fps":0, "start_frame":0, "cap_frames":0, "use_for_dim":false}], // duration: seconds to load, 0 = to the end of the clip; fps: the rate duration is counted in, 0 = whatever the file reports; start_frame: 1-based first frame to load, 0 means the same as 1; cap_frames: max frames to load, 0 = no cap. When duration and cap_frames are both set, the smaller window wins
          "audios":[{"name":"voice_ref", "order":1, "audio_path":"C:/path/to/voice.wav", "from_video":0}]
        },
        "steps": { "value": 30 },          // number of denoising steps
        "split_step": { "value": 0 },      // NOT USED by MiniMax H3 node
        "seed": { "value": 0, "randomize": false }, // seed value; randomize: re-rolls each run
        "cfg_high": { "value": 6.0 },      // guidance scale (single CFG — labeled "CFG" in the UI)
        "cfg_low": { "value": 0.0 },       // NOT USED by MiniMax H3 node
        "total_frames": { "value": 124 },  // total frames; H3 renders best where (frames - 5) % 17 == 0 — 124 is 5s at 24 fps
        "fps": { "value": 24.0 },          // output video frame rate
        "master_prompt": { "text": "", "position": "before" },   // base prompt; combined with positive when type is not "smart"
        "positive_prompt": { "text": "A cinematic shot of ...", "type": "smart" }, // type "smart" forwards only this text to the relay node
        "negative_prompt": { "text": "" }, // negative prompt text
        "trail_prompt":{ "text": "" },
        "loras": {
          "lora_1": { "name": "", "strength": 1.0, "enabled": true }, // LoRA slot 1: filename, weight multiplier, active toggle
          "lora_2": { "name": "", "strength": 1.0, "enabled": true }, // LoRA slot 2
          "lora_3": { "name": "", "strength": 1.0, "enabled": true }, // LoRA slot 3
          "lora_4": { "name": "", "strength": 1.0, "enabled": true }, // LoRA slot 4
          "lora_5": { "name": "", "strength": 1.0, "enabled": true }, // LoRA slot 5
          "lora_6": { "name": "", "strength": 1.0, "enabled": true }, // LoRA slot 6
          "lora_7": { "name": "", "strength": 1.0, "enabled": true }, // LoRA slot 7
          "lora_8": { "name": "", "strength": 1.0, "enabled": true }  // LoRA slot 8
        },
        "filename": { "file": "" },        // output filename (without extension)
        "flags": {
          "flag_1": { "label": "flag 1", "value": false }, // custom boolean toggle 1; label is the display name
          "flag_2": { "label": "flag 2", "value": false }, // custom boolean toggle 2
          "flag_3": { "label": "flag 3", "value": false }  // custom boolean toggle 3
        },
        "custom": {
          "param_1": { "label": "param 1", "value": "" }, // custom string parameter 1; label is the display name
          "param_2": { "label": "param 2", "value": "" }  // custom string parameter 2
        }
      }
    ]
  }
}
